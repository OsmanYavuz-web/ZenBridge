# ==========================================
# ZenBridge Environment Configuration
# ==========================================

# Port for ZenBridge to listen on (Default: 8080)
PORT=8080

# Host address to bind to (Default: 127.0.0.1)
HOST=127.0.0.1

# OpenCode Upstream Bridge Server URL (Default: http://127.0.0.1:4096)
OPENCODE_BASE_URL=http://127.0.0.1:4096

# Optional API Key to require from incoming proxy clients
# Leave blank to disable authentication
API_KEY=

# Default model when client omits "model" in request body
# Options: "auto" (picks active free models randomly/load-balanced) or a specific model ID (e.g. "mimo-v2.5-free")
DEFAULT_MODEL=auto

# Security & Public Exposure:
# Set to "true" when exposing to the public internet to disable HTML Dashboard & Swagger UI documentation (/docs, /swagger, /openapi.json)
# Default: false
DISABLE_PUBLIC_UI=false
